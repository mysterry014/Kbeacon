<!-- [수정3] 루트 레이아웃: 클릭/포커스 금지 -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/listLayout"
    android:clickable="false"
    android:focusable="false"
    android:longClickable="false">

    <!-- [수정3] 새로운 레이아웃: 2행 구조, 클릭 금지 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:clickable="false"
        android:focusable="false"
        android:longClickable="false">

        <!-- 첫번째 행: 비콘 정보 표시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            
            <!-- 왼쪽: 이름과 거리 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <!-- [수정3] 이름 TextView만 클릭 허용 + 터치 피드백 -->
                <TextView
                    android:id="@+id/tv_beacon_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비콘 이름"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:clickable="true"
                    android:focusable="false"
                    android:background="?android:attr/selectableItemBackground"/>
                    
                <TextView
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="거리: 0.0m"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            
            <!-- 중간: RSSI -->
            <TextView
                android:id="@+id/tv_rssi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="-0.0dBm"
                android:textSize="14sp"
                android:layout_marginEnd="16dp"/>
                
            <!-- 오른쪽: 배터리 -->
            <TextView
                android:id="@+id/tv_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="배터리: 0%"
                android:textSize="14sp"/>
        </LinearLayout>
        
        <!-- 두번째 행: 버튼들 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            
            <Button
                android:id="@+id/btn_ring_alarm"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="알람"
                android:textSize="12sp"
                android:focusable="false"
                android:layout_marginEnd="4dp"/>
                
            <Button
                android:id="@+id/btn_ring_alarm_stop"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="알람 중지"
                android:textSize="12sp"
                android:focusable="false"
                android:layout_marginEnd="4dp"/>
                
            <Button
                android:id="@+id/btn_distance_setting"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="거리설정"
                android:textSize="12sp"
                android:focusable="false"
                android:layout_marginEnd="4dp"/>
                
            <Button
                android:id="@+id/btn_calibration"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="거리보정"
                android:focusable="false"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 기존 레이아웃은 숨김 처리 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/beacon_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:text="@string/track_name"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/beacon_rssi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|right"
                android:layout_weight="0.4"
                android:text="@string/BEACON_RSSI_VALUE"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:orientation="horizontal"
            android:weightSum="1">


            <TextView
                android:id="@+id/beacon_mac_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="0.5"
                android:text="@string/BEACON_MAC_ADDRESS" />


            <TextView
                android:id="@+id/beacon_battery_percent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="right"
                android:layout_weight="0.5"
                android:text="@string/BEACON_VOLTAGE" />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:id="@+id/ll_eddy_tlm"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_tlm_beacon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ADV_TYPE_TLM" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:id="@+id/ll_iBeacon_uuid"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_ibeacon_uuid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/BEACON_UUID" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:id="@+id/ll_iBeacon_major"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_iBeacon_major"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/BEACON_MAJOR" />

        </LinearLayout>



        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:orientation="horizontal"
            android:id="@+id/ll_sensor_item1"
            android:weightSum="1">

            <TextView
                android:id="@+id/tv_sensor_item1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/BEACON_TEMPERATURE" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:id="@+id/ll_sensor_item2"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_sensor_item2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/BEACON_ACC_POS" />

        </LinearLayout>


    </LinearLayout>

</RelativeLayout>