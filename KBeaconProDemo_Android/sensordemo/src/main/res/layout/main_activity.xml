<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    >

    <!-- 상단 타이틀바 추가: 디바이스 리스트 | 스캔 시작/정지 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        
        <TextView
            android:id="@+id/tv_device_list_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="디바이스 리스트"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"/>
            
        <Button
            android:id="@+id/btn_scan_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="스캔 시작"
            android:layout_marginEnd="8dp"/>
            
        <Button
            android:id="@+id/btn_scan_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="스캔 정지"/>
    </LinearLayout>
    
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:focusable="true"
            android:background="@color/white"
            android:focusableInTouchMode="true"
            android:orientation="horizontal"
            android:weightSum="1.0">


            <Button
                android:id="@+id/btnFilterInfo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:gravity="start|center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="5dp"
                android:layout_weight="1.0"
                android:textAllCaps="false"
                android:background="@color/transparent"
                android:textColor="@color/gray"
                android:hint="@string/BEACON_FILTER_BEACON" />

            <Button
                android:id="@+id/btnRemoveAllFilter"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/remove" />

            <Button
                android:id="@+id/imageButtonArrow"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="5dp"
                android:background="@drawable/downarrow" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layFilterName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:focusable="true"
            android:background="@color/white"
            android:focusableInTouchMode="true"
            android:orientation="horizontal"
            android:weightSum="1.0">


            <EditText
                android:id="@+id/editFilterName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1.0"
                android:layout_marginStart="10dp"
                android:hint="@string/BEACON_FILTER_NAME"
                android:inputType="textPersonName"
                android:paddingEnd="5dp"
                android:maxLines="1"
                android:textSize="14sp" />


            <Button
                android:id="@+id/btmRemoveFilterName"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/remove" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layRssiFilter"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/white"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:orientation="horizontal"
            android:weightSum="1.0">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:hint="@string/BEACON_RSSI_Filter_title" />


            <SeekBar
                android:id="@+id/seekBarRssiFilter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:max="80"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/txtViewRssiValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="3dp"
                android:text="-100dBm"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />
        </LinearLayout>


    </LinearLayout>


    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/listview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"></ListView>

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- 하단 폰 알람 버튼 바 추가 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@android:color/darker_gray"/>
        
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">
        
        <Button
            android:id="@+id/btn_phone_alarm"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="폰 알람"
            android:textSize="16sp"/>
            
        <Button
            android:id="@+id/btn_phone_alarm_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="폰 알람 중지"
            android:textSize="16sp"/>
    </LinearLayout>

</LinearLayout>
